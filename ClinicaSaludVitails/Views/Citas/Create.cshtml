@model ClinicaSaludVitails.Models.Cita

@{
    ViewData["Title"] = "Registrar Cita";
}

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="card shadow-lg border-0 rounded-4">

            <div class="card-header bg-primary text-white rounded-top-4">

                <h3 class="mb-1">
                    📅 Registrar Cita Médica
                </h3>

                <small>
                    Complete la información para programar una nueva cita.
                </small>

            </div>

            <div class="card-body p-4">

                <form asp-action="Create">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="PacienteId" class="form-label fw-bold">
                                Paciente
                            </label>

                            <select asp-for="PacienteId"
                                    class="form-select"
                                    asp-items="ViewBag.PacienteId">
                            </select>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="MedicoId" class="form-label fw-bold">
                                Médico
                            </label>

                            <select asp-for="MedicoId"
                                    class="form-select"
                                    asp-items="ViewBag.MedicoId">
                            </select>

                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="Fecha" class="form-label fw-bold"></label>

                            <input asp-for="Fecha"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="Fecha" class="text-danger"></span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="Hora" class="form-label fw-bold"></label>

                            <input asp-for="Hora"
                                   type="time"
                                   class="form-control" />

                            <span asp-validation-for="Hora" class="text-danger"></span>

                        </div>

                    </div>

                    <div class="mb-4">

                        <label asp-for="Estado" class="form-label fw-bold"></label>

                        <select asp-for="Estado" class="form-select">

                            <option>Programada</option>
                            <option>Confirmada</option>
                            <option>Atendida</option>
                            <option>Cancelada</option>

                        </select>

                        <span asp-validation-for="Estado" class="text-danger"></span>

                    </div>

                    <hr />

                    <div class="d-flex justify-content-end gap-2">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            ↩ Cancelar
                        </a>

                        <button type="submit"
                                class="btn btn-primary">
                            💾 Registrar Cita
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}