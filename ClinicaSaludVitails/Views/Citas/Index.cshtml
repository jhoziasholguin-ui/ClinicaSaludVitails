@model IEnumerable<ClinicaSaludVitails.Models.Cita>

@{
    ViewData["Title"] = "Agenda Médica";
}

<div class="container py-4">

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">

        <div class="card-header bg-primary text-white p-4" style="background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h3 class="mb-1 fw-bold d-flex align-items-center gap-2">
                        <i class="bi bi-calendar-check-fill"></i> Agenda Médica
                    </h3>
                    <p class="text-white-50 small mb-0">
                        Gestión de citas y programación médica centralizada
                    </p>
                </div>

                <div class="d-flex gap-2">
                    <a asp-action="Create" class="btn btn-light text-primary fw-semibold shadow-sm d-flex align-items-center gap-2">
                        <i class="bi bi-plus-circle-fill"></i> Nueva Cita
                    </a>
                    <a asp-action="ExportarExcel" asp-controller="Citas" class="btn btn-success fw-semibold shadow-sm d-flex align-items-center gap-2">
                        <i class="bi bi-file-earmark-excel-fill"></i> Exportar
                    </a>
                </div>
            </div>
        </div>

        <div class="card-body p-4">

            <div class="mb-4 d-flex align-items-center justify-content-between">
                <span class="badge bg-primary-subtle text-primary fs-6 px-3 py-2 rounded-3 fw-semibold">
                    <i class="bi bi-hash"></i> Total de citas: @Model.Count()
                </span>
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-info text-center rounded-3 p-5 border-0 bg-light">
                    <i class="bi bi-calendar-x text-info display-4 mb-3 d-block"></i>
                    <h5 class="fw-bold">No existen citas registradas</h5>
                    <p class="text-muted mb-0">
                        Presione el botón <strong class="text-primary">"Nueva Cita"</strong> en la cabecera para comenzar.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-secondary text-uppercase fs-7 opacity-75">
                            <tr>
                                <th class="ps-3">Paciente</th>
                                <th>Médico</th>
                                <th class="text-center">Fecha</th>
                                <th class="text-center">Hora</th>
                                <th class="text-center">Estado</th>
                                <th width="180" class="text-end pe-3">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-medium text-dark">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="icon-shape bg-primary-subtle text-primary rounded-circle" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                                <i class="bi bi-person-fill fs-6"></i>
                                            </div>
                                            @item.Paciente.Apellidos, @item.Paciente.Nombres
                                        </div>
                                    </td>

                                    <td class="text-secondary fw-medium">
                                        <i class="bi bi-person-badge-fill text-success-emphasis me-1"></i> Dr. @item.Medico.Apellidos
                                    </td>

                                    <td class="text-center text-dark fw-medium">
                                        <i class="bi bi-calendar3 text-muted me-1"></i> @item.Fecha.ToString("dd/MM/yyyy")
                                    </td>

                                    <td class="text-center text-dark">
                                        <span class="badge bg-light text-dark border fw-normal px-2 py-1.5">
                                            <i class="bi bi-clock text-muted me-1"></i> @item.Hora
                                        </span>
                                    </td>

                                    <td class="text-center">
                                        @if (item.Estado == "Programada")
                                        {
                                            <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-semibold">Programada</span>
                                        }
                                        else if (item.Estado == "Atendida")
                                        {
                                            <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-semibold">Atendida</span>
                                        }
                                        else if (item.Estado == "Cancelada")
                                        {
                                            <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-semibold">Cancelada</span>
                                        }
                                        else if (item.Estado == "Confirmada")
                                        {
                                            <span class="badge bg-warning-subtle text-warning px-3 py-2 rounded-pill fw-semibold">Confirmada</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary px-3 py-2 rounded-pill fw-semibold">@item.Estado</span>
                                        }
                                    </td>

                                    <td class="pe-3 text-end">
                                        <div class="d-inline-flex gap-2">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light text-primary border shadow-sm" title="Ver detalles">
                                                <i class="bi bi-eye-fill"></i>
                                                rattle
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light text-warning border shadow-sm" title="Editar">
                                                <i class="bi bi-pencil-fill"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light text-danger border shadow-sm" title="Eliminar">
                                                <i class="bi bi-trash-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>