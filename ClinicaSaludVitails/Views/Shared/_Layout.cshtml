@using Microsoft.AspNetCore.Http

@{
    var userRole = Context.Session.GetString("UserRole");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Clínica Salud Vitalis</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ClinicaSaludVitails.styles.css" asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100 bg-light">

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm py-3">
        <div class="container">

            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <i class="bi bi-heart-pulse-fill"></i> Clínica Salud Vitalis
            </a>

            <button class="navbar-toggler border-0"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarClinic">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarClinic">

                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link active" asp-controller="Home" asp-action="Index">Inicio</a>
                    </li>

                    @if (!string.IsNullOrEmpty(userRole))
                    {
                        if (userRole == "Administrador" || userRole == "Recepcionista")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Pacientes" asp-action="Index">Pacientes</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Citas" asp-action="Index">Citas</a>
                            </li>
                        }

                      
                        @if (userRole == "Administrador")
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-semibold"
                                   asp-controller="Home"
                                   asp-action="Dashboard">
                                    <i class="bi bi-speedometer2 me-1"></i>
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Medicos"
                                   asp-action="Index">
                                    Médicos
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Especialidads"
                                   asp-action="Index">
                                    Especialidades
                                </a>
                            </li>
                        }


                        if (userRole == "Medico")
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-semibold text-warning" asp-controller="Citas" asp-action="MiAgenda">
                                    <i class="bi bi-calendar3 me-1"></i> Mi Agenda Diaria
                                </a>
                            </li>
                        }
                    }
                </ul>

                <ul class="navbar-nav mb-2 mb-lg-0">
                    @if (string.IsNullOrEmpty(userRole))
                    {
                        <li class="nav-item">
                            <a class="btn btn-light text-primary fw-semibold px-4 shadow-sm"
                               asp-controller="Account"
                               asp-action="Login">
                                Iniciar Sesión
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white fw-semibold bg-white bg-opacity-10 rounded-3 px-3"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i> @userRole
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                <li>
                                    <a class="dropdown-item text-danger"
                                       asp-controller="Account"
                                       asp-action="Logout">
                                        <i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                </ul>

            </div>

        </div>
    </nav>

    <main class="flex-grow-1 container py-5">

        @if (!string.IsNullOrEmpty(userRole))
        {
            <div class="mb-5">
                <h2 class="fw-bold text-dark mb-1">Sistema de Gestión Clínica</h2>
                <p class="text-muted mb-0">Panel de administración general y servicios interconectados.</p>
            </div>
        }

        @RenderBody()

    </main>

    <footer class="footer mt-auto py-4 bg-white border-top">
        <div class="container text-center">
            <span class="text-muted small">
                © 2026 <strong>Clínica Salud Vitalis</strong> | Todos los derechos reservados.
            </span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>