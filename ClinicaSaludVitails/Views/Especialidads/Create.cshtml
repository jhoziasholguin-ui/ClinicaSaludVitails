@model ClinicaSaludVitails.Models.Especialidad

@{
    ViewData["Title"] = "Nueva Especialidad";
}

<div class="row justify-content-center">

    <div class="col-md-8 col-lg-6">

        <div class="card shadow-sm border-0">

            <div class="card-header bg-white">

                <h3 class="text-primary mb-0">
                    Nueva Especialidad Médica
                </h3>

                <small class="text-muted">
                    Registro de especialidades para el cuerpo médico
                </small>

            </div>

            <div class="card-body">

                <form asp-action="Create">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <div class="mb-3">

                        <label asp-for="Nombre"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Nombre"
                               class="form-control"
                               placeholder="Ejemplo: Cardiología" />

                        <span asp-validation-for="Nombre"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">

                            Guardar

                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            Cancelar

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}