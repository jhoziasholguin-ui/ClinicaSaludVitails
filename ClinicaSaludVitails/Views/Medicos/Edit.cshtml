
@model ClinicaSaludVitails.ViewModels.MedicoEditViewModel

@{
    ViewData["Title"] = "Editar médico";
}

<div class="container py-4">
    <!-- Encabezado -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="text-muted small mb-1">
                Administración / Médicos / Editar
            </div>
            <h2 class="fw-bold mb-1">Editar médico</h2>
            <p class="text-muted mb-0">
                Actualiza la información profesional y administra su acceso al sistema.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Volver a médicos
        </a>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"
             role="alert"></div>

        <div class="row g-4">
            <!-- Información profesional -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white py-3">
                        <h5 class="fw-bold mb-1">
                            <i class="bi bi-person-vcard me-2 text-primary"></i>
                            Información profesional
                        </h5>
                        <small class="text-muted">
                            Datos personales y profesionales del médico.
                        </small>
                    </div>

                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Nombres" class="form-label fw-semibold">
                                    Nombres
                                </label>
                                <input asp-for="Nombres"
                                       class="form-control"
                                       placeholder="Ingrese los nombres" />
                                <span asp-validation-for="Nombres"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Apellidos" class="form-label fw-semibold">
                                    Apellidos
                                </label>
                                <input asp-for="Apellidos"
                                       class="form-control"
                                       placeholder="Ingrese los apellidos" />
                                <span asp-validation-for="Apellidos"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Correo" class="form-label fw-semibold">
                                    Correo institucional
                                </label>
                                <input asp-for="Correo"
                                       type="email"
                                       class="form-control"
                                       placeholder="medico@clinicasaludvitails.com" />
                                <span asp-validation-for="Correo"
                                      class="text-danger small"></span>
                                <div class="form-text">
                                    Este correo se utilizará como usuario de acceso
                                    si creas una cuenta para el médico.
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CMP" class="form-label fw-semibold">
                                    CMP
                                </label>
                                <input asp-for="CMP"
                                       class="form-control"
                                       placeholder="Número de colegiatura" />
                                <span asp-validation-for="CMP"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EspecialidadId"
                                       class="form-label fw-semibold">
                                    Especialidad
                                </label>
                                <select asp-for="EspecialidadId"
                                        class="form-select"
                                        asp-items="ViewBag.EspecialidadId">
                                    <option value="">Seleccione una especialidad</option>
                                </select>
                                <span asp-validation-for="EspecialidadId"
                                      class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cuenta de acceso -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white py-3">
                        <h5 class="fw-bold mb-1">
                            <i class="bi bi-shield-lock me-2 text-primary"></i>
                            Cuenta de acceso
                        </h5>
                        <small class="text-muted">
                            Gestiona el acceso del médico a su agenda.
                        </small>
                    </div>

                    <div class="card-body p-4">
                        @if (Model.TieneCuenta)
                        {
                            <div class="alert alert-success">
                                <div class="d-flex align-items-start gap-2">
                                    <i class="bi bi-check-circle-fill fs-5"></i>
                                    <div>
                                        <strong>Cuenta vinculada</strong>
                                        <p class="mb-0 small">
                                            Este médico ya tiene una cuenta de acceso.
                                            No es necesario crear otra.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-1"></i>
                                Este médico todavía no tiene una cuenta. Puedes
                                crearla sin registrar nuevamente su ficha.
                            </div>

                            <div class="form-check form-switch mb-3">
                                <input asp-for="CrearCuenta"
                                       class="form-check-input"
                                       role="switch"
                                       id="CrearCuenta" />
                                <label asp-for="CrearCuenta"
                                       class="form-check-label fw-semibold">
                                    Crear cuenta de acceso
                                </label>
                            </div>

                            <div id="seccionPassword"
                                 class="@(Model.CrearCuenta ? "" : "d-none")">
                                <label asp-for="Password"
                                       class="form-label fw-semibold">
                                    Contraseña inicial
                                </label>

                                <div class="input-group">
                                    <input asp-for="Password"
                                           type="password"
                                           class="form-control"
                                           id="Password"
                                           autocomplete="new-password"
                                           placeholder="Ingrese una contraseña" />

                                    <button class="btn btn-outline-secondary"
                                            type="button"
                                            id="mostrarPassword"
                                            aria-label="Mostrar u ocultar contraseña">
                                        <i class="bi bi-eye" id="iconoPassword"></i>
                                    </button>
                                </div>

                                <span asp-validation-for="Password"
                                      class="text-danger small"></span>

                                <div class="form-text mt-2">
                                    Mínimo 6 caracteres, con una mayúscula,
                                    una minúscula y un número.
                                </div>
                            </div>

                            <hr class="my-4" />

                            <div class="small text-muted">
                                <i class="bi bi-person-lock me-1"></i>
                                La cuenta se vinculará a este médico y tendrá
                                el rol <strong>Medico</strong>.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Acciones -->
        <div class="d-flex flex-wrap justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-light border px-4">
                Cancelar
            </a>

            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-floppy me-1"></i>
                Guardar cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const crearCuenta = document.getElementById("CrearCuenta");
            const seccionPassword = document.getElementById("seccionPassword");
            const password = document.getElementById("Password");
            const mostrarPassword = document.getElementById("mostrarPassword");
            const iconoPassword = document.getElementById("iconoPassword");

            if (crearCuenta && seccionPassword) {
                crearCuenta.addEventListener("change", function () {
                    seccionPassword.classList.toggle("d-none", !this.checked);

                    if (!this.checked && password) {
                        password.value = "";
                    }
                });
            }

            if (mostrarPassword && password && iconoPassword) {
                mostrarPassword.addEventListener("click", function () {
                    const mostrar = password.type === "password";
                    password.type = mostrar ? "text" : "password";

                    iconoPassword.className = mostrar
                        ? "bi bi-eye-slash"
                        : "bi bi-eye";
                });
            }
        });
    </script>
}
