
@model ClinicaSaludVitails.ViewModels.MedicoCreateViewModel

@{
    ViewData["Title"] = "Registrar médico";
}

<h1>Registrar médico</h1>
<p class="text-muted">
    Registra la ficha profesional y, si corresponde, su cuenta de acceso.
</p>

<hr />

<div class="row">
    <div class="col-md-6 col-lg-5">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="Nombres"></label>
                <input asp-for="Nombres" class="form-control" />
                <span asp-validation-for="Nombres"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Apellidos"></label>
                <input asp-for="Apellidos" class="form-control" />
                <span asp-validation-for="Apellidos"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Correo">Correo institucional</label>
                <input asp-for="Correo" type="email"
                       class="form-control"
                       placeholder="medico@clinicasaludvitails.com" />
                <span asp-validation-for="Correo"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CMP"></label>
                <input asp-for="CMP" class="form-control" />
                <span asp-validation-for="CMP"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EspecialidadId"></label>
                <select asp-for="EspecialidadId"
                        asp-items="ViewBag.EspecialidadId"
                        class="form-control">
                    <option value="">Seleccione una especialidad</option>
                </select>
                <span asp-validation-for="EspecialidadId"
                      class="text-danger"></span>
            </div>

            <hr />

            <div class="form-check mb-3">
                <input asp-for="CrearCuenta"
                       class="form-check-input" />
                <label asp-for="CrearCuenta"
                       class="form-check-label">
                    Crear cuenta de acceso para este médico
                </label>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Password">
                    Contraseña inicial
                </label>
                <input asp-for="Password"
                       type="password"
                       class="form-control"
                       autocomplete="new-password" />
                <span asp-validation-for="Password"
                      class="text-danger"></span>
                <small class="text-muted">
                    Se requiere si marcas la casilla de creación de cuenta.
                </small>
            </div>

            <button type="submit" class="btn btn-primary">
                Guardar médico
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Volver
            </a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
