@model ClinicaSaludVitails.Models.Paciente

@{
    ViewData["Title"] = "Detalle del Paciente";
}

<div class="row justify-content-center">

    <div class="col-md-8">

        <div class="card shadow-sm border-0">

            <div class="card-header bg-white">

                <h3 class="text-primary mb-0">
                    Información del Paciente
                </h3>

                <small class="text-muted">
                    Consulta de datos registrados
                </small>

            </div>

            <div class="card-body">

                <div class="row mb-3">

                    <div class="col-md-4 fw-bold text-secondary">
                        DNI
                    </div>

                    <div class="col-md-8">
                        @Model.DNI
                    </div>

                </div>

                <div class="row mb-3">

                    <div class="col-md-4 fw-bold text-secondary">
                        Nombres
                    </div>

                    <div class="col-md-8">
                        @Model.Nombres
                    </div>

                </div>

                <div class="row mb-3">

                    <div class="col-md-4 fw-bold text-secondary">
                        Apellidos
                    </div>

                    <div class="col-md-8">
                        @Model.Apellidos
                    </div>

                </div>

                <div class="row mb-3">

                    <div class="col-md-4 fw-bold text-secondary">
                        Teléfono
                    </div>

                    <div class="col-md-8">
                        @Model.Telefono
                    </div>

                </div>

                <hr />

                <div class="d-flex gap-2">

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary">

                        Editar

                    </a>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Volver

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>